{
  "name": "messier-engine",
  "version": "0.9.0",
  "description": "Browser-based WebGPU 3D engine with dynamic lights, glTF/OBJ loading and a real-time scene editor",
  "license": "PolyForm-Shield-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate:sample": "node scripts/generate-sample-glb.mjs",
    "generate:demo": "node scripts/generate-demo-project.mjs",
    "generate:materials-glb": "node scripts/generate-material-glb.mjs",
    "generate:materials": "node scripts/generate-material-lab.mjs",
    "generate:heist": "node scripts/generate-twilight-heist.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.54",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
